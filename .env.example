# Postgres connection (used by database/backend.py, which switches
# automatically to Postgres when this is set -- see database/postgres_db.py).
# Leave unset to use the SQLite fallback in database/db.py instead.
#
# For a free, permanent, no-credit-card Postgres with pgvector included,
# use Neon (neon.com): create a project, run `CREATE EXTENSION vector;`
# in its SQL editor, then paste its connection string here. It looks like:
#   postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:labpass@localhost:5432/ai_research_lab

# Optional: set to require this value in the X-API-Key header on write
# endpoints, for callers not using a user account. Leave unset in local
# dev to disable the API-key path entirely (JWT auth still works either way).
API_KEY=

# Signs JWT session tokens issued by /auth/login and /auth/register.
# Change this in any real deployment -- the default is dev-only.
JWT_SECRET=dev-only-secret-change-me

# Ollama's local OpenAI-compatible API. Leave blank for localhost.
# In Docker Compose the API container defaults to host.docker.internal instead.
OLLAMA_BASE_URL=
OLLAMA_REPORTS=false

# Document retrieval backend: auto uses pgvector with Postgres, otherwise TF-IDF.
RETRIEVAL_BACKEND=auto

# Used by the Next.js frontend to reach the backend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
